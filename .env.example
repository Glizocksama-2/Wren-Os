VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback if your Supabase project still uses anon keys.
# Prefer VITE_SUPABASE_PUBLISHABLE_KEY for new projects.
VITE_SUPABASE_ANON_KEY=

# Express auth API.
VITE_AUTH_API_BASE_URL=
DATABASE_URL=
JWT_SECRET=
CORS_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174
PORT=4000
POSTGRES_SSL=false

# Server-side only. Use either a webhook URL, or a Telegram bot token plus chat id.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Server-side only. 32+ characters; encrypts per-user Telegram bot tokens.
TELEGRAM_SECRET_KEY=
