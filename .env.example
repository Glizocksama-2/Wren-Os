VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback if your Supabase project still uses anon keys.
# Prefer VITE_SUPABASE_PUBLISHABLE_KEY for new projects.
VITE_SUPABASE_ANON_KEY=

# Express auth API.
VITE_AUTH_API_BASE_URL=
DATABASE_URL=
JWT_SECRET=
CORS_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174
PORT=4000
POSTGRES_SSL=false
NORTHWATCH_APP_URL=http://127.0.0.1:5173

# Optional invite email delivery. Without SMTP_HOST, invite links are logged by the API.
INVITE_EMAIL_FROM=Northwatch <no-reply@northwatch.app>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Server-side only. Use either a webhook URL, or a Telegram bot token plus chat id.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Server-side only. 32+ characters; encrypts per-user Telegram bot tokens.
TELEGRAM_SECRET_KEY=

# Server-side Alpha Vantage financial data. Never prefix with VITE_ or expose it in the browser bundle.
ALPHA_VANTAGE_API_KEY=

# Server-side RapidAPI key for Nairobi Stock Exchange live data. Never prefix with VITE_.
RAPIDAPI_NSE_KEY=

# Optional shared RapidAPI key. Used by Intel providers when a provider-specific key is not set.
RAPIDAPI_KEY=

# Optional server-side RapidAPI key for Seeking Alpha market news. Never prefix with VITE_.
RAPIDAPI_SEEKING_ALPHA_KEY=

# Optional server-side RapidAPI key for Real-Time News Data. Never prefix with VITE_.
RAPIDAPI_REAL_TIME_NEWS_KEY=
RAPIDAPI_REAL_TIME_NEWS_QUERIES=Kenya Africa business technology crypto
RAPIDAPI_REAL_TIME_NEWS_STORY_ID=
RAPIDAPI_REAL_TIME_NEWS_COUNTRY=US
RAPIDAPI_REAL_TIME_NEWS_LANG=en

# Server-side RapidAPI key for Copilot5 system AI. Never prefix with VITE_.
RAPIDAPI_COPILOT_KEY=

# Server-side RapidAPI key for workout plate analysis. Never prefix with VITE_.
RAPIDAPI_WORKOUT_KEY=

# Server-side RapidAPI key for Open Weather13 forecasts. Never prefix with VITE_.
RAPIDAPI_WEATHER_KEY=

# Intel still keeps public fallbacks for RSS, CoinGecko, Yahoo Finance, exchange rates, CBK/KNBS/NSE/Safaricom pages.
